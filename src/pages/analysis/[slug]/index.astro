---
import Base from '../../../layouts/Base.astro';
import { getAnalyses } from '../../../lib/analysis.js';
import { wfHtml } from '../../../lib/wf.js';

/* 요약 페이지 — 처음 보는 사람 기준. 글은 분석 파일의 brief에서 온다. 근거와 각주는 전체 기록(/full)에 둔다 */
export async function getStaticPaths() {
  const analyses = await getAnalyses();
  return analyses.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const b = a.brief;
const learning = a.format === 'principles';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={a.title} description={a.summary}>
  <div class="wrap read analysis">
    <section style="padding-top:48px">
      <a class="back" href={`${base}/analysis/`}>서비스 분석</a>
      <div class="case-head">
        <h1>{a.title}</h1>
        <p class="bactions">
          <span>분석일 {a.analyzed}</span>
          {a.pdf && <a href={`${base}/${a.slug}-analysis.pdf`} download={`오현석_${a.service}_서비스분석.pdf`}>요약 PDF</a>}
          <a href={`${base}/analysis/${a.slug}/full/`}>전체 기록</a>
        </p>
      </div>
      <dl class="brows lead">
        {b.glance.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
      </dl>
    </section>

    <div class="brief">
      <section>
        <h2>{learning ? '어떤 조건을 비교했나' : '어떤 서비스인가'}</h2>
        <dl class="brows">
          {b.context.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
        </dl>
      </section>

      <section>
        <h2>{learning ? '화면에서 읽은 설계 원리' : '무엇이 문제인가'}</h2>
        <figure class="bshot">
          {b.shot.pairs
            ? <div class="dgm" role="group" aria-label={b.shot.alt}>{b.shot.pairs.map((p) => <ol>{p.map((x) => <li>{x}</li>)}</ol>)}</div>
            : <img src={`${base}/${b.shot.src}`} width={b.shot.w} height={b.shot.h} alt={b.shot.alt} loading="lazy" decoding="async" />}
          <figcaption>{b.shot.caption}</figcaption>
        </figure>
        <ul class="blist">{b.problem.map((x) => <li>{x}</li>)}</ul>
      </section>

      {learning && a.slug === 'coupang-amazon' && <section><h2>실제 상품 상세에서 확인한 차이</h2><figure class="bshot"><a href={`${base}/analysis/coupang-amazon/CF2-S01.jpg`}><img src={`${base}/analysis/coupang-amazon/CF2-S01.jpg`} width="1098" height="482" alt="쿠팡 상세의 와우 가입 쿠폰가와 일반가, 판매자로켓 및 판매자 정보" loading="lazy" /></a><figcaption>쿠팡: 일반가·가입 쿠폰가, 판매자와 배송 약속을 함께 표시한다. 2026-11-05 관찰. 이미지를 누르면 원본으로 볼 수 있다.</figcaption></figure></section>}
      <section>
        <h2>{learning ? '어떤 조건에서 패턴이 달라지나' : '왜 이 문제인가'}</h2>
        <table class="bcand">
          <thead><tr><th scope="col">{learning ? '설계 조건' : '문제 후보'}</th><th scope="col">{learning ? '패턴의 변화' : '고를 때의 약점'}</th></tr></thead>
          <tbody>
            {b.candidates.map((c) => (
              <tr class:list={{ picked: c.picked }}>
                <td>{c.name}{c.picked && <span class="bpick">선택</span>}</td>
                <td>{c.weak}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="bwhy">{b.why}</p>
      </section>

      {b.fixes.length > 0 && <section>
        <h2>{learning ? '새로운 설계에 어떻게 적용했나' : '어떻게 고칠까'}</h2>
        <ol class="bfixes">
          {b.fixes.map((f) => <li><h3>{f.title}</h3><p>{f.body}</p><p class="effort">{learning ? '적용 조건' : '구현 난이도'} {f.effort}</p></li>)}
        </ol>
      </section>}

      {learning && a.slug === 'coupang-amazon' && <section><h2>원리를 적용한 주요 화면</h2><p>가상 커머스의 정적 시안이다. 가격과 운영 정책은 설계 가정이다.</p><details><summary>검색·상세·반복 주문 관리 화면 펼쳐 보기</summary>{[1,2,3].map((n) => <Fragment set:html={wfHtml(`analysis/coupang-amazon/wireframe-${n}.svg`, ['상품·도착 조건으로 후보를 좁히는 가상 검색 화면','상품가·배송비·회비와 구매 방식을 구분하는 가상 상세 화면','변경 마감과 건너뛰기·중단을 구분하는 가상 반복 주문 관리 화면'][n-1])} />)}</details></section>}
      {a.application && <section><h2>원리를 적용한 주요 화면</h2><p>{a.application.note}</p><details open={a.application.shots.length === 1}><summary>적용 화면 {a.application.shots.length}개 펼쳐 보기</summary>{a.application.shots.map((shot) => <figure class="bshot" style="margin-top:20px"><figcaption style="margin:0 0 -12px">{shot.alt}</figcaption><Fragment set:html={wfHtml(shot.src, shot.alt)} /></figure>)}</details></section>}
      <section>
        <h2>어떻게 검증할까</h2>
        <dl class="brows">
          {b.test.map((r) => <div><dt>{r.k}</dt><dd>{r.v}</dd></div>)}
        </dl>
      </section>

      <section class="bduo">
        <div>
          <h2>{learning ? '적용할 때의 전제' : '감수할 위험'}</h2>
          <ul class="blist">{b.risks.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div>
          <h2>이 분석의 한계</h2>
          <ul class="blist">{b.limits.map((x) => <li>{x}</li>)}</ul>
        </div>
      </section>

      <p class="bfull">근거 {a.evidence}건과 {learning ? '원리·적용의 상세 근거는' : '진단 전체는'} <a href={`${base}/analysis/${a.slug}/full/`}>전체 기록</a>에서 볼 수 있다.</p>
    </div>
  </div>
  <style is:global>
    @page { size: A4; }
  </style>
</Base>
