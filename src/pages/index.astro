---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

/* 메타 한 줄(`기간 · 소속 · 인원 · 역할`)을 세 줄로 가른다 — 기간 / 소속 / 인원 · 역할.
   좌단이 좁아(화면 190px · 인쇄 168px) 한 줄로 두면 구분점 뒤에서 아무 데나 접힌다. */
const splitMeta = (meta) => {
  const [term = '', org = '', ...rest] = (meta ?? '').split(' · ');
  return { term, org, who: rest.join(' · ') };
};
const caps = (await getCollection('capabilities')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* 첫 프로젝트는 화면 캡처와 함께 넓게 싣는다 — 만든 화면을 보여줄 수 있는 유일한 운영 서비스다 */
const FEATURE = 'checkmate';
---
<Base>
  <div class="wrap">

    <header class="hero">
      <div class="hero-main">
        {/* 눈썹 라벨(profile.eyebrow)은 화면에 싣지 않는다 — 지역·직함 띠는 템플릿 인상을 준다. 데이터는 볼트 원본이라 남겨 둔다 */}
        <h1>{profile.name}<span class="latin mono">{profile.name_latin}</span></h1>
        <p class="thesis">{profile.thesis}</p>

        {/* 화면에서는 상단바가 연락처를 담당하고, 인쇄본에서만 노출된다 */}
        <p class="contact-print">
          <a href="#" data-mail data-mail-text></a>
          <span>·</span>
          <span>{profile.github.replace('https://', '')}</span>
        </p>
      </div>

      <dl class="facts">
        {profile.facts.map((f) => (
          <div><dt class="mono">{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </header>

    <section class="reveal">
      <div class="shead"><h2>이력</h2></div>
      <div class="hist">
        {profile.history.map((h) => (
          <div class="hrow">
            <div class="when mono">{h.when}</div>
            <div class="what">{h.what}{h.live && <span class="live mono">운영 중</span>}</div>
            <div class="role">{h.role}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="projects" class="reveal">
      <div class="shead"><h2>프로젝트</h2></div>
      <div class="proj">
        {projects.map((p) => (
          <a class:list={['prow', { feature: p.data.slug === FEATURE }]} href={`${base}/projects/${p.data.slug}`}>
            <div>
              <div class="pname">{p.data.name}
                {p.data.live && <span class="live mono">운영 중</span>}
              </div>
              <div class="pmeta mono">
                <span class="pterm">{splitMeta(p.data.meta).term}</span>
                <span class="porg">{splitMeta(p.data.meta).org}</span>
                <span class="pwho">{splitMeta(p.data.meta).who}</span>
              </div>
            </div>
            <div>
              <div class="pkind">{p.data.kind}</div>
              <div class="pdesc">{p.data.summary}</div>
              <div class="presult">
                <span class="arrow">결과</span>
                <span class="mono">{p.data.result}</span>
                {p.data.spark && (
                  <svg width="80" height="22" viewBox="0 0 80 22" aria-hidden="true">
                    <polyline points="4,17 40,9 76,4" fill="none" stroke="var(--signal)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="76" cy="4" r="2.8" fill="var(--signal)" />
                  </svg>
                )}
                {p.data.resultNote && <span class="arrow">{p.data.resultNote}</span>}
              </div>
              {p.data.caveat && <div class="pcaveat">{p.data.caveat}</div>}
            </div>
            {p.data.slug === FEATURE && (
              <figure class="pshot">
                <img src={`${base}/img/checkmate-dashboard.webp`} width="1300" height="725" loading="lazy" decoding="async"
                     alt="CheckMate 관리자 대시보드 개요 탭 화면" />
              </figure>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="reveal">
      <div class="shead"><h2>역량</h2></div>
      <div class="caps">
        {caps.map((c) => (
          <div class="cap">
            <h3>{c.data.name}</h3>
            <p>{c.data.tags.join(' · ')}</p>
            {c.data.source && <div class="src mono"><b>관련</b> {c.data.source}</div>}
          </div>
        ))}
      </div>
    </section>

    <section class="reveal">
      <div class="shead"><h2>자격 · 학력</h2></div>
      <div class="creds">
        <div class="cgroup">
          <h3 class="mono">자격 · 어학</h3>
          <ul>
            {profile.certs.map((c) => (
              <li><div><b>{c.name}</b><span class="sub">{c.sub}</span></div><span class="date mono">{c.date}</span></li>
            ))}
          </ul>
        </div>
        <div class="cgroup">
          <h3 class="mono">학력 · 교육</h3>
          <ul>
            {profile.education.map((e) => (
              <li><div><b>{e.name}</b><span class="sub">{e.sub}</span></div><span class="date mono">{e.date}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

  </div>
</Base>
