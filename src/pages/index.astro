---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import stages from '../data/stages.json';
import { getCollection } from 'astro:content';
import MediaChips from '../components/MediaChips.astro';
import { nb } from '../lib/nb.js';
import QRCode from 'qrcode';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
/* 대표 칸 = 단계마다 사례 1건 — 표에서 바로 사례로 넘어간다 */
const projs = await getCollection('projects');
const proj = (slug) => projs.find((p) => p.data.slug === slug)?.data;
// 인쇄본(PDF) 1쪽 머리 — 웹 전체로 가는 QR(👤 10-13 · GPT 피드백 #3)
const siteUrl = new URL(`${base}/`, Astro.site).href;
const siteQr = await QRCode.toString(siteUrl, { type: 'svg', margin: 4, errorCorrectionLevel: 'M' });
const leadOf = (pj, no) => stages.cases.find((c) => c.pj === pj && c.stage === no);
---
<Base heroPdf>
  <div class="wrap home">

    <header class="hero">
      <div class="hero-main">
        {/* 눈썹 라벨(profile.eyebrow)은 화면에 싣지 않는다 — 지역·직함 띠는 템플릿 인상을 준다. 데이터는 볼트 원본이라 남겨 둔다 */}
        <h1>{profile.name}<span class="latin mono">{profile.name_latin}</span></h1>
        <p class="thesis">{profile.thesis.split(/(?<=,) /).map((x, i) => <>{i > 0 && ' '}<span class="seg">{x}</span></>)}</p>

        {/* 첫 행동 = PDF. 「대표 사례 보기」는 사례 칸이 바로 아래라 뺐다(👤 10-13). 인쇄본에서는 숨긴다 */}
        <div class="hero-cta">
          <a class="btn" href={`${base}/hyunseok-oh-portfolio.pdf`} download="오현석_포트폴리오.pdf">포트폴리오 PDF</a>
        </div>

        {/* 화면에서는 상단바가 연락처를 담당하고, 인쇄본에서만 노출된다 */}
        <p class="contact-print">
          <a href="#" data-mail data-mail-text></a>
          <span>·</span>
          <a href={profile.github}>{profile.github.replace('https://', '')}</a>
        </p>
        <aside class="qr-print qr-home" aria-hidden="true">
          <Fragment set:html={siteQr} />
          <p>웹 포트폴리오<br /><span class="mono">{siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span></p>
        </aside>
      </div>

      <dl class="facts">
        {profile.facts.map((f) => (
          <div><dt class="mono">{f.k}</dt><dd set:html={nb(f.v)} /></div>
        ))}
      </dl>
    </header>

    {/* 대표 사례가 먼저, 단계 표는 그 아래 탐색용(외부 피드백 #1 · 04 §3-B 2026-10-12 보정). 인쇄본(PDF)은 CSS order로 표 → 사례 그대로 */}
    <section id="cases" class="reveal">
      <div class="shead"><h2>단계별 대표 사례</h2></div>
      <div class="cases">
        {stages.cases.map((c, i) => (
          <a class="ccard" href={`${base}/cases/${c.path}`}>
            {c.thumb && <img class="cthumb" src={`${base}/${c.thumb.src}`} width={c.thumb.w} height={c.thumb.h} alt={c.thumb.alt} loading="lazy" decoding="async" />}
            <span class="cno"><span class="mono">STEP {String(c.stage).padStart(2, '0')}</span> · {c.stageName}</span>
            <h3>{c.title.split(/(?<=때) /).map((x, i) => <>{i > 0 && ' '}<span class="seg">{x}</span></>)}</h3>
            <span class="cmeta">{c.meta.split(' · ').slice(0, 2).join(' · ')}</span>
            <span class="cgo">사례 읽기 →</span>
            <span class="cpage">이 PDF {i + 2}쪽 · 웹 ↗</span>
          </a>
        ))}
      </div>
    </section>

    {/* 단계 × 프로젝트 표 — "어느 단계를 어디서 했나"(04 §3-B · 2026-10-11 D형).
        칸 문장은 볼트 지원서 원고의 「단계표」 칸 그대로(sync). 「→」 = 내가 다음에 한 일 → 한 단계 한 줄로 끊는다 */}
    <section id="overview" class="reveal">
      <div class="shead"><h2>{stages.title}</h2></div>
      {/* 단계 거르기 — 고른 단계 열만 남기고(넓은 화면은 나머지를 흐리게, 좁은 화면은 감춘다) · 표시만 바꾼다 */}
      <div class="sfilter" role="group" aria-label="단계로 거르기">
        <span class="sfpill" aria-hidden="true"></span>
        <button type="button" data-stage="0" aria-pressed="true">전체</button>
        {stages.stages.map((s) => (
          <button type="button" data-stage={s.no} aria-pressed="false"><span class="mono">{String(s.no).padStart(2, '0')}</span>{s.name}</button>
        ))}
      </div>
      <div class="sgrid" role="table" aria-label="프로젝트별 단계 표" data-stage="0">
        <div class="srow shead-row" role="row">
          <div role="columnheader"><span class="sr">프로젝트</span></div>
          {stages.stages.map((s) => (
            <div class="sth" role="columnheader" data-col={s.no}><span class="mono">{String(s.no).padStart(2, '0')}</span>{s.name}</div>
          ))}
        </div>
        {stages.rows.map((r) => (
          <div class="srow" role="row" data-has={r.cells.map((t, i) => (t ? i + 1 : '')).join('')}>
            <div class="spj" role="rowheader">
              <a href={`${base}/projects/${r.slug}`}><b>{r.pj}{r.live && <span class="live mono">운영 중</span>}</b></a>
              <span class="what">{r.what}</span>
              <span class="when mono">{r.when}</span>
              <MediaChips links={proj(r.slug)?.links} note={proj(r.slug)?.linksNote} name={r.pj} />
            </div>
            {r.cells.map((t, i) => {
              const lead = leadOf(r.pj, i + 1);
              return t ? (
                <div class:list={['scell', { lead }]} role="cell" data-col={i + 1}>
                  <span class="sname"><span class="mono">{String(i + 1).padStart(2, '0')}</span> {stages.stages[i].name}</span>
                  <ol>{t.split(' → ').map((x) => <li>{x.split(' · ').map((y) => <span>{y}</span>)}</li>)}</ol>
                  {lead && <a class="slead" href={`${base}/cases/${lead.path}`}>사례 읽기 →</a>}
                </div>
              ) : (
                <div class="scell none" role="cell" aria-label="해당 없음" data-col={i + 1}></div>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <section class="reveal">
      <div class="shead"><h2>이력</h2></div>
      <div class="hist">
        {profile.history.map((h) => (
          <div class="hrow">
            <div class="when mono">{h.when}</div>
            <div class="what">{h.what}{h.live && <span class="live mono">운영 중</span>}</div>
            <div class="role">{h.role}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal">
      <div class="shead"><h2>자격 · 학력</h2></div>
      <div class="creds">
        <div class="cgroup">
          <h3>자격 · 어학</h3>
          <ul>
            {profile.certs.map((c) => (
              <li><div><b>{c.name}</b><span class="sub">{c.sub}</span></div><span class="date mono">{c.date}</span></li>
            ))}
          </ul>
        </div>
        <div class="cgroup">
          <h3>학력 · 교육</h3>
          <ul>
            {profile.education.map((e) => (
              <li><div><b>{e.name}</b><span class="sub">{e.sub}</span></div><span class="date mono">{e.date}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

  </div>
  <script>
    const grid = document.querySelector<HTMLElement>('.sgrid');
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.sfilter button')];
    /* 고른 단추 뒤 검은 알약이 미끄러져 간다(10-12 움직임) — 스크립트가 없으면 단추 자체가 칠해진다 */
    const filter = document.querySelector<HTMLElement>('.sfilter')!;
    const pill = filter.querySelector<HTMLElement>('.sfpill')!;
    const place = () => {
      const on = btns.find((x) => x.getAttribute('aria-pressed') === 'true')!;
      pill.style.width = `${on.offsetWidth}px`; pill.style.height = `${on.offsetHeight}px`;
      pill.style.transform = `translate(${on.offsetLeft}px, ${on.offsetTop}px)`;
    };
    place(); filter.classList.add('js-pill');
    requestAnimationFrame(() => requestAnimationFrame(() => filter.classList.add('ready')));   // 첫 자리는 움직이지 않고 놓는다
    addEventListener('resize', place);
    document.fonts?.ready.then(place);
    btns.forEach((b) => b.addEventListener('click', () => {
      grid!.dataset.stage = b.dataset.stage;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      place();
    }));
    /* 열 강조 — 마우스·키보드 초점이 머문 단계 열 전체를 옅게 칠한다(넓은 화면) */
    const setCol = (c?: string) => { if (c) grid!.dataset.hover = c; else delete grid!.dataset.hover; };
    grid!.addEventListener('pointerover', (e) => setCol((e.target as HTMLElement).closest<HTMLElement>('[data-col]')?.dataset.col));
    grid!.addEventListener('pointerleave', () => setCol());
    grid!.addEventListener('focusin', (e) => setCol((e.target as HTMLElement).closest<HTMLElement>('[data-col]')?.dataset.col));
    grid!.addEventListener('focusout', () => setCol());
  </script>
</Base>
