---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={d.name} description={d.kind}>
  <div class="wrap">
    <section style="padding-top:48px">
      <a class="back" href={`${base}/#projects`}>← 프로젝트 목록</a>

      <div class="case-head">
        <h1>{d.name}{d.live && <span class="live mono">운영 중</span>}</h1>
        <p class="kind">{d.kind}</p>
        <p class="meta mono">{d.meta}</p>
        <div class="presult">
          <span class="arrow">결과</span>
          <span class="mono">{d.result}</span>
          {d.resultNote && <span class="arrow">{d.resultNote}</span>}
        </div>
        {d.caveat && <p class="caveat">{d.caveat}</p>}
      </div>

      <div class="prose">
        <Content />
      </div>

      {(d.links.length > 0 || d.linksNote) && (
        <div class="links">
          <h2>링크</h2>
          {d.links.length > 0 && (
            <ul>
              {d.links.map((l) => (
                <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>
              ))}
            </ul>
          )}
          {d.linksNote && <p class="note">{d.linksNote}</p>}
        </div>
      )}
    </section>
  </div>
</Base>
