---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import profile from '../data/profile.json';

interface Props { title?: string; description?: string; jsonld?: unknown[]; heroPdf?: boolean }
const { title, description, jsonld = [], heroPdf = false } = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.thesis}`;
const desc = description ?? profile.thesis;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const siteUrl = new URL(`${base}/`, Astro.site).href;

// 구조화 데이터 — 검색엔진 색인과 AI 검색(GEO) 인용에 쓰인다.
// 이메일·전화번호는 넣지 않는다. 소스에 평문으로 남으면 난독화가 무의미해진다 (04 §7).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: profile.name,
  alternateName: profile.name_latin,
  givenName: '현석',
  familyName: '오',
  jobTitle: '프로덕트 매니저',
  description: profile.thesis,
  url: siteUrl,
  sameAs: [profile.github],
  alumniOf: profile.education.map((e) => ({ '@type': 'Organization', name: e.name })),
  hasCredential: profile.certs.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    description: c.sub,
  })),
  knowsAbout: [
    '제품 기획', '데이터 기반 의사결정', '퍼널 분석', '그로스', '지표 설계',
    'PRD 작성', '프로젝트 운영', '생성형 AI 활용', 'SQL', 'NestJS', 'React',
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: `${profile.name} 포트폴리오`,
  inLanguage: 'ko-KR',
  author: { '@id': `${siteUrl}#person` },
};

const schemas = [personSchema, siteSchema, ...jsonld];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} | ${profile.thesis}`} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <div class="topbar">
      <div class="wrap">
        <a class="who mono" href={`${base}/`} style="text-decoration:none">{profile.name_latin}</a>
        <nav class="cta">
          <a class="btn" href={`${base}/#overview`}>프로젝트</a>
          {/* 첫 화면은 히어로 버튼이 PDF를 맡아 머리 메뉴에서는 뺀다(👤 10-12) */}
          {!heroPdf && <a class="btn" href={`${base}/hyunseok-oh-portfolio.pdf`} download="오현석_포트폴리오.pdf"><span class="wide">포트폴리오 </span>PDF</a>}
          <a class="btn primary" href="#" data-mail>이메일</a>
        </nav>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    {/* 이메일 난독화 — 평문 mailto를 소스에 남기지 않는다 (04 §7) */}
    <script type="module" define:vars={{ user: profile.email.split('@')[0], host: profile.email.split('@')[1] }}>
      const addr = `${user}@${host}`;
      for (const el of document.querySelectorAll('[data-mail]')) {
        el.setAttribute('href', `mailto:${addr}`);
        if (el.dataset.mailText !== undefined) el.textContent = addr;
      }
    </script>
    {/* 페이지 안 영상 플레이어 — 바깥으로 나가지 않고 시연을 본다. 닫으면 iframe을 비워 재생을 멈춘다 */}
    <dialog id="player" class="player" aria-label="영상 보기">
      <div class="phead"><p class="ptitle"></p><button type="button" class="pclose" aria-label="닫기">✕</button></div>
      <div class="pframe"></div>
      <p class="pnote"></p>
    </dialog>
    <script>
      const dlg = document.getElementById('player') as HTMLDialogElement;
      const frame = dlg.querySelector('.pframe')!;
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-yt]');
        if (!b) return;
        e.preventDefault();
        frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0" title="${b.dataset.title ?? ''}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
        dlg.querySelector('.ptitle')!.textContent = b.dataset.title ?? '';
        dlg.querySelector('.pnote')!.textContent = b.dataset.note ?? '';
        dlg.showModal();
      });
      dlg.querySelector('.pclose')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => { frame.innerHTML = ''; });

      /* 섹션 등장 — 2026-10-11 스크롤 연동 애니메이션(animation-timeline: view())을 걷어냈다.
         뒤로가기로 돌아오면 스크롤 위치만 복원되고 타임라인이 멈춰, 화면 안 섹션이 투명하게 남았다(실측: 자격·학력 opacity 0).
         지금은 화면에 들어오면 한 번 보이고 다시 숨지 않는다 · 복원(pageshow)·움직임 줄이기·관찰 불가 브라우저는 바로 보인다 */
      const els = [...document.querySelectorAll<HTMLElement>('.reveal')];
      const showAll = () => els.forEach((el) => el.classList.add('in'));
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) showAll();
      else {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((ents) => {
          for (const en of ents) if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => { if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in'); else io.observe(el); });
      }
      /* 그림 그리기(10-12 움직임) — 타임라인은 선이 그어지며 점이 차례로, 막대는 왼쪽에서 차오른다. 화면에 들어올 때 한 번 · 조건은 섹션 등장과 같다 */
      const draws = [...document.querySelectorAll<HTMLElement>('.ctl, .cbars')];
      const drawAll = () => draws.forEach((el) => el.classList.add('in'));
      if (draws.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        draws.forEach((el) => [...el.querySelectorAll<HTMLElement>(':scope > li, .brow')].forEach((c, i) => c.style.setProperty('--i', String(i))));
        document.documentElement.classList.add('js-draw');
        const dio = new IntersectionObserver((ents) => {
          for (const en of ents) if (en.isIntersecting) { en.target.classList.add('in'); dio.unobserve(en.target); }
        }, { threshold: 0.35 });
        draws.forEach((el) => dio.observe(el));
      }
      addEventListener('pageshow', (e) => { if (e.persisted) { showAll(); drawAll(); } });
      addEventListener('beforeprint', () => { showAll(); drawAll(); });

      /* 화면 갤러리 — 가로로 밀거나 버튼으로 넘긴다(scroll-snap) · 현재 번호 표시 */
      for (const gal of document.querySelectorAll<HTMLElement>('.gal')) {
        const track = gal.querySelector<HTMLElement>('.gtrack')!;
        const items = [...track.children] as HTMLElement[];
        const count = gal.querySelector('.gcount b')!;
        const x = (el: HTMLElement) => el.offsetLeft - items[0].offsetLeft;
        const cur = () => items.reduce((best, el, i) => Math.abs(x(el) - track.scrollLeft) < Math.abs(x(items[best]) - track.scrollLeft) ? i : best, 0);
        // 트랙 높이 = 지금 화면 높이(가장 큰 화면 기준이면 작은 화면 아래가 빈다)
        const fit = () => { track.style.height = `${items[cur()].offsetHeight}px`; };
        track.addEventListener('scroll', () => { count.textContent = String(cur() + 1); requestAnimationFrame(fit); }, { passive: true });
        addEventListener('resize', fit);
        track.querySelectorAll('img').forEach((im) => im.complete || im.addEventListener('load', fit, { once: true }));
        fit();
        gal.querySelectorAll<HTMLButtonElement>('.gnav button').forEach((b) => b.addEventListener('click', () => {
          const n = Math.min(items.length - 1, Math.max(0, cur() + Number(b.dataset.dir)));
          track.scrollTo({ left: x(items[n]), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }));
      }
      </script>
  </body>
</html>
