---
import '../styles/global.css';
import profile from '../data/profile.json';

interface Props { title?: string; description?: string; jsonld?: unknown[] }
const { title, description, jsonld = [] } = Astro.props;

const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.thesis}`;
const desc = description ?? profile.thesis;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const siteUrl = new URL(`${base}/`, Astro.site).href;

// 구조화 데이터 — 검색엔진 색인과 AI 검색(GEO) 인용에 쓰인다.
// 이메일·전화번호는 넣지 않는다. 소스에 평문으로 남으면 난독화가 무의미해진다 (04 §7).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: profile.name,
  alternateName: profile.name_latin,
  jobTitle: '프로덕트 매니저',
  description: profile.thesis,
  url: siteUrl,
  sameAs: [profile.github],
  alumniOf: profile.education.map((e) => ({ '@type': 'Organization', name: e.name })),
  hasCredential: profile.certs.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    description: c.sub,
  })),
  knowsAbout: [
    '제품 기획', '데이터 기반 의사결정', '퍼널 분석', '그로스', '지표 설계',
    'PRD 작성', '프로젝트 운영', '생성형 AI 활용', 'SQL', 'NestJS', 'React',
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: `${profile.name} 포트폴리오`,
  inLanguage: 'ko-KR',
  author: { '@id': `${siteUrl}#person` },
};

const schemas = [personSchema, siteSchema, ...jsonld];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.thesis}`} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>📊</text></svg>" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>

    <div class="topbar">
      <div class="wrap">
        <a class="who mono" href={`${base}/`} style="text-decoration:none">{profile.name_latin}</a>
        <nav class="cta">
          <a class="btn" href={`${base}/#projects`}>프로젝트</a>
          <a class="btn" href={`${base}/오현석_이력서.pdf`}>이력서 PDF</a>
          <a class="btn primary" href="#" data-mail>이메일</a>
        </nav>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <p class="fnote">{profile.footnote}</p>
      </div>
    </footer>

    {/* 이메일 난독화 — 평문 mailto를 소스에 남기지 않는다 (04 §7) */}
    <script type="module" define:vars={{ user: profile.email.split('@')[0], host: profile.email.split('@')[1] }}>
      const addr = `${user}@${host}`;
      for (const el of document.querySelectorAll('[data-mail]')) {
        el.setAttribute('href', `mailto:${addr}`);
        if (el.dataset.mailText !== undefined) el.textContent = addr;
      }
    </script>
  </body>
</html>
